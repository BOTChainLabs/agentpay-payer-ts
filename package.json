    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.28.0"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "viem": "2.48.11"
  },
  "engines": {
    "node": ">=20"
  }
}
