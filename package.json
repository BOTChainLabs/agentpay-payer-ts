{
  "name": "@botchainlabs/agentpay-payer",
  "version": "0.1.0-rc.2",
  "description": "Thin BOT Chain x402 payer adapter",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOTChainLabs/agentpay-payer-ts.git"
  },
  "bugs": {
    "url": "https://github.com/BOTChainLabs/agentpay-payer-ts/issues"
  },
  "homepage": "https://github.com/BOTChainLabs/agentpay-payer-ts#readme",
  "keywords": [
    "agentpay",
    "botchain",
    "x402",
    "payments"
  ],
  "publishConfig": {
